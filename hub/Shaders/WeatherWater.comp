#version 460 core
// ============================================================================
//  THE GROUND'S WATER AND SNOW, ONE STEP
//
//  Every texel of the weather map is the top surface at that place. Each step:
//
//    1. HOW MUCH OF THE FALL REACHES IT: a ray from the surface up the
//       falling weather (u_Fall, slanted by the wind), through the map's
//       heights - so the lee of a wall stays dry in a gale.
//    2. THE SURFACE'S OWN WATER (WeatherSurface::Step on the CPU is the same
//       arithmetic): snow lying or melting, the pores filling, the film,
//       standing water from what the film cannot hold, soaking away at the
//       surface's saturated rate, and drying while nothing arrives.
//    3. STANDING WATER RUNS DOWNHILL: to each of the four neighbours, a fifth
//       of the difference in water level (ground + water), never more than a
//       quarter of what the giver holds. Both sides compute the same
//       exchange with opposite signs, so water is conserved; a roof drains
//       over its edge, a hollow fills, a slope sheds it.
//
//  Layers: 0, 1 water (ping-pong) r soak 0..1, g film 0..1, b depth mm, a snow
//  mm; 2, 3 static r top - RefY (m), g SurfaceType, a 1 if any surface.
// ============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) uniform image2DArray u_Map;

uniform int   u_Res;
uniform int   u_Src, u_Dst, u_Static;
uniform float u_Texel;          // metres
uniform float u_Dt;             // seconds
uniform float u_Rain, u_Snow;   // mm/h in the open
uniform float u_Temp;           // C
uniform float u_Evap;           // mm/h
uniform float u_PuddleRate;
uniform vec3  u_Fall;
uniform float u_FlowK;
uniform vec4  u_Porosity4[4];
uniform vec4  u_Infil4[4];

const float kFilmMm = 0.10;
const float kMaxDepthMm = 30.0;

float Porosity(int t) { return u_Porosity4[t >> 2][t & 3]; }
float Infil(int t)    { return u_Infil4[t >> 2][t & 3]; }

bool Inside(ivec2 p) { return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, ivec2(u_Res))); }

// The top surface's height, relative to the map's RefY; very low for none.
float TopAt(ivec2 p) {
    vec4 s = imageLoad(u_Map, ivec3(p, u_Static));
    return s.a > 0.5 ? s.r : -1000.0;
}

float Exposure(ivec2 id, float top) {
    if (u_Rain <= 0.0 && u_Snow <= 0.0) return 1.0;
    // Up the fall from 15 cm above the surface; a step out of the map is open sky.
    const float kT[7] = float[](0.4, 1.0, 2.0, 3.5, 6.0, 10.0, 16.0);
    vec3 P = vec3(0.0, top + 0.15, 0.0);
    for (int i = 0; i < 7; ++i) {
        vec3 q = P - u_Fall * kT[i];
        ivec2 c = id + ivec2(floor(q.xz / u_Texel + 0.5));
        if (!Inside(c)) return 1.0;
        if (TopAt(c) > q.y) return 0.0;
    }
    return 1.0;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= u_Res || id.y >= u_Res) return;
    vec4 st = imageLoad(u_Map, ivec3(id, u_Static));
    vec4 w0 = imageLoad(u_Map, ivec3(id, u_Src));
    int type = int(st.g + 0.5);
    if (st.a < 0.5 || type == 12) { imageStore(u_Map, ivec3(id, u_Dst), vec4(0.0)); return; }
    float top = st.r;

    // ---- 3. the flow, from the water as it stood (both sides agree) ----
    float flow = 0.0;
    float eta = top * 1000.0 + w0.b;
    const ivec2 kN[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    for (int k = 0; k < 4; ++k) {
        ivec2 n = id + kN[k];
        if (!Inside(n)) continue;
        vec4 ns = imageLoad(u_Map, ivec3(n, u_Static));
        if (ns.a < 0.5 || int(ns.g + 0.5) == 12) continue;
        float nw = imageLoad(u_Map, ivec3(n, u_Src)).b;
        float d = (ns.r * 1000.0 + nw) - eta;
        flow += clamp(u_FlowK * d, -w0.b * 0.25, nw * 0.25);
    }

    // ---- 2. the surface's own water ----
    float hours = u_Dt / 3600.0;
    float por = Porosity(type);
    float cap = 0.02 + 0.35 * clamp(por, 0.0, 1.0);
    float soak = clamp(w0.r, 0.0, 1.0) * cap;
    float film = clamp(w0.g, 0.0, 1.0) * kFilmMm;
    float depth = max(w0.b + flow, 0.0);
    float snow = max(w0.a, 0.0);
    float expo = Exposure(id, top);
    float liquid = u_Rain * expo * hours;
    float snowIn = u_Snow * expo * hours;
    if (u_Temp > 1.5) { liquid += snowIn; snowIn = 0.0; }
    snow += snowIn;
    float melt = min(snow, max(u_Temp, 0.0) * 0.25 * hours);
    snow -= melt;
    liquid += melt;
    bool arriving = liquid > 0.0 || snowIn > 0.0;

    float drink = max(min(min(liquid, cap - soak), clamp(por, 0.0, 1.0) * 60.0 * hours + 1e-9), 0.0);
    soak += drink;
    liquid -= drink;
    film += liquid;
    float runoff = max(film - kFilmMm, 0.0);
    film = min(film, kFilmMm);
    depth += runoff * u_PuddleRate;
    float drain = (max(Infil(type), 0.0) + 4.0) * hours / max(u_PuddleRate, 0.05);
    depth = clamp(depth - drain, 0.0, kMaxDepthMm);
    if (!arriving) {
        float e = u_Evap * hours;
        float dd = min(depth, e); depth -= dd; e -= dd;
        float f = min(film, e); film -= f;
        if (depth <= 0.0) soak = max(soak - u_Evap * hours * 0.35, 0.0);
    }
    imageStore(u_Map, ivec3(id, u_Dst), vec4(soak / cap, film / kFilmMm, depth, snow));
}
