#version 460 core
// ---------------------------------------------------------------
//  Fiona Zi Engine — which lamps reach which part of the view
//  Copyright (c) 2026 Nabras. All rights reserved.
// ---------------------------------------------------------------
//
// ONE INVOCATION PER CLUSTER: the cluster's box in the world, every lamp's
// sphere of reach against it, and the survivors written as a list.
//
// A cluster is a screen tile cut to a slice of depth - a small frustum. Its
// eight corners are found by walking each tile corner's ray out to the
// slice's two depths (depth measured along the camera's forward, so every
// slice is flat); the box round them is a little larger than the frustum, so
// a lamp is sometimes listed for a cluster it only nearly reaches and never
// missed from one it does. A spot is tested by the sphere of its range: the
// cone is decided per pixel, where it costs a dot product.

layout(local_size_x = 64) in;

struct FZELight {
    vec4 PosRange;
    vec4 Intensity;
    vec4 DirCos;
    vec4 Params;
    vec4 Extra;
};
layout(std430, binding = 4) readonly buffer FZELightBuffer { FZELight lights[]; };
layout(std430, binding = 5) writeonly buffer FZEClusterBuffer { uvec2 clusters[]; };
layout(std430, binding = 6) writeonly buffer FZEItemBuffer { uint items[]; };
layout(std430, binding = 7) buffer FZECounter { uint used; };

uniform mat4  u_InvViewProj;
uniform vec3  u_Eye;
uniform vec3  u_Forward;
uniform vec3  u_Grid;            // tiles x, tiles y, slices
uniform float u_Near;
uniform float u_Far;
uniform int   u_LightCount;
uniform int   u_DirectionalCount;
uniform int   u_ItemCapacity;

#define MAX_PER_CLUSTER 64

vec3 CornerAt(vec2 ndc, float depth) {
    vec4 f = u_InvViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(f.xyz / f.w - u_Eye);
    return u_Eye + dir * (depth / max(dot(dir, u_Forward), 1e-4));
}

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint X = uint(u_Grid.x), Y = uint(u_Grid.y), Z = uint(u_Grid.z);
    if (c >= X * Y * Z) return;
    uint tx = c % X, ty = (c / X) % Y, tz = c / (X * Y);

    vec2 n0 = vec2(float(tx), float(ty)) / vec2(X, Y) * 2.0 - 1.0;
    vec2 n1 = vec2(float(tx + 1u), float(ty + 1u)) / vec2(X, Y) * 2.0 - 1.0;
    float ratio = u_Far / u_Near;
    float d0 = u_Near * pow(ratio, float(tz) / float(Z));
    float d1 = u_Near * pow(ratio, float(tz + 1u) / float(Z));
    // The last slice reaches to infinity: nothing past the far plane is lost.
    if (tz + 1u == Z) d1 = 1e5;

    vec3 lo = vec3(1e30), hi = vec3(-1e30);
    for (int k = 0; k < 8; ++k) {
        vec2 ndc = vec2((k & 1) != 0 ? n1.x : n0.x, (k & 2) != 0 ? n1.y : n0.y);
        vec3 p = CornerAt(ndc, (k & 4) != 0 ? d1 : d0);
        lo = min(lo, p); hi = max(hi, p);
    }

    uint list[MAX_PER_CLUSTER];
    uint n = 0u;
    for (int i = u_DirectionalCount; i < u_LightCount && n < uint(MAX_PER_CLUSTER); ++i) {
        vec3 center = lights[i].PosRange.xyz;
        float r = lights[i].PosRange.w;
        vec3 q = clamp(center, lo, hi);
        vec3 dq = center - q;
        if (dot(dq, dq) <= r * r) list[n++] = uint(i);
    }

    uint offset = atomicAdd(used, n);
    if (offset + n > uint(u_ItemCapacity)) { clusters[c] = uvec2(0u, 0u); return; }
    for (uint k = 0u; k < n; ++k) items[offset + k] = list[k];
    clusters[c] = uvec2(offset, n);
}
